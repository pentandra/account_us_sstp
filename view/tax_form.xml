<?xml version="1.0"?>

<data>
    <xpath expr="/form/group[@id='checkboxes']/field[@name='template_override']" position="after">
        <label name="authority_override"/>
        <field name="authority_override" xexpand="0" width="100"/>
    </xpath>
    <xpath expr="/form/notebook/page[@id='general']/label[@name='start_date']" position="before">
        <label name="place"/>
        <field name="place"/>
        <label name="code"/>
        <field name="code"/>
    </xpath>
    <xpath expr="/form/notebook/page[@id='general']/field[@name='childs']" position="before">
        <label name="sourcing"/>
        <field name="sourcing"/>
        <label name="product_class"/>
        <field name="product_class"/>
    </xpath>
</data>
