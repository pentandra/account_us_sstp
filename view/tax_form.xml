<?xml version="1.0"?>

<data>
    <xpath expr="/form/notebook/page[@id='general']/label[@name='start_date']" position="before">
        <label name="jurisdiction"/>
        <field name="jurisdiction"/>
        <newline/>
    </xpath>
    <xpath expr="/form/notebook/page[@id='general']" position="after">
        <page string="Streamlined Sales Tax Parameters" id="sst_params">
            <label name="sourcing"/>
            <field name="sourcing"/>
            <label name="rate_type"/>
            <field name="rate_type"/>
        </page>
    </xpath>
</data>
